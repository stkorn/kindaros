{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:kinda:pos-event:v1",
  "title": "Kinda completed sale v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "event_type",
    "event_id",
    "produced_at",
    "sale"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "event_type": {
      "const": "sale.completed"
    },
    "event_id": {
      "type": "string",
      "format": "uuid"
    },
    "produced_at": {
      "$ref": "#/$defs/utcTimestamp"
    },
    "sale": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "source_system",
        "source_instance",
        "branch_id",
        "business_date",
        "receipt_id",
        "occurred_at",
        "currency",
        "tax_mode",
        "gross_amount",
        "discount_amount",
        "net_amount",
        "tax_amount",
        "lines"
      ],
      "properties": {
        "source_system": {
          "enum": [
            "simulator",
            "wongnai_csv"
          ]
        },
        "source_instance": {
          "$ref": "#/$defs/id"
        },
        "branch_id": {
          "enum": [
            "BR001",
            "BR002",
            "BR003"
          ]
        },
        "business_date": {
          "type": "string",
          "format": "date"
        },
        "receipt_id": {
          "$ref": "#/$defs/id"
        },
        "occurred_at": {
          "$ref": "#/$defs/utcTimestamp"
        },
        "currency": {
          "const": "THB"
        },
        "gross_amount": {
          "$ref": "#/$defs/money"
        },
        "discount_amount": {
          "$ref": "#/$defs/money"
        },
        "net_amount": {
          "$ref": "#/$defs/money"
        },
        "tax_amount": {
          "$ref": "#/$defs/money"
        },
        "lines": {
          "type": "array",
          "minItems": 1,
          "maxItems": 100,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "line_id",
              "product_id",
              "quantity",
              "unit_price",
              "gross_amount",
              "discount_amount",
              "net_amount",
              "tax_amount"
            ],
            "properties": {
              "line_id": {
                "$ref": "#/$defs/id"
              },
              "product_id": {
                "$ref": "#/$defs/id"
              },
              "quantity": {
                "type": "integer",
                "minimum": 1,
                "maximum": 1000
              },
              "unit_price": {
                "$ref": "#/$defs/money"
              },
              "gross_amount": {
                "$ref": "#/$defs/money"
              },
              "discount_amount": {
                "$ref": "#/$defs/money"
              },
              "net_amount": {
                "$ref": "#/$defs/money"
              },
              "tax_amount": {
                "$ref": "#/$defs/money"
              }
            }
          }
        },
        "tax_mode": {
          "enum": [
            "explicit_included_component",
            "not_provided"
          ]
        }
      }
    }
  },
  "$defs": {
    "id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]*$"
    },
    "money": {
      "type": "string",
      "pattern": "^(0|[1-9][0-9]{0,9})\\.[0-9]{2}$"
    },
    "utcTimestamp": {
      "type": "string",
      "format": "date-time",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$"
    }
  }
}
